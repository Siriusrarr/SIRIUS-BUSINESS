# PostgreSQL. En local puedes usar localhost; en Render pega la URL interna de la BD.
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/sirius_business?schema=public"

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Cookie de sesión. En el despliegue de un solo dominio, SameSite=Lax es adecuado.
SESSION_COOKIE_NAME=sirius_session
SESSION_DURATION_DAYS=7
COOKIE_SAME_SITE=lax

# SMTP obligatorio para enviar verificación y recuperación reales.
# Puedes usar los datos SMTP de Brevo, Resend u otro proveedor de correo.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASS=contrasena_smtp
SMTP_FROM="Sirius Business <no-reply@tudominio.com>"
