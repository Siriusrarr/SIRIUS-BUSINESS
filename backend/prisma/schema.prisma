generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(80)
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  emailVerifiedAt DateTime?
  selectedPlan String? @db.VarChar(32)
  planSelectedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  verificationTokens EmailVerificationToken[]
  passwordTokens PasswordResetToken[]
  ownedBusiness Business? @relation("BusinessOwner")
  memberships BusinessMember[]
  tutorialProgress TutorialProgress[]
  @@index([createdAt])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Business {
  id String @id @default(uuid()) @db.Uuid
  ownerId String @unique @db.Uuid
  name String @db.VarChar(120)
  legalName String? @db.VarChar(160)
  taxId String? @db.VarChar(40)
  category String? @db.VarChar(80)
  phone String? @db.VarChar(40)
  email String? @db.VarChar(254)
  address String? @db.VarChar(220)
  city String? @db.VarChar(100)
  currency String @default("COP") @db.VarChar(3)
  lowStockThreshold Int @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members BusinessMember[]
  products Product[]
  customers Customer[]
  suppliers Supplier[]
  sales Sale[]
  expenses Expense[]
  promotions Promotion[]
  integrations Integration[]
  store StoreSettings?
  tutorialProgress TutorialProgress[]
  @@index([createdAt])
}
model BusinessMember {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  userId String @db.Uuid
  role String @default("member") @db.VarChar(20)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([businessId, userId])
  @@index([userId, active])
}
model Product {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  name String @db.VarChar(140)
  sku String? @db.VarChar(60)
  barcode String? @db.VarChar(100)
  description String? @db.Text
  category String? @db.VarChar(80)
  unit String @default("unidad") @db.VarChar(30)
  cost Decimal @default(0) @db.Decimal(14,2)
  price Decimal @db.Decimal(14,2)
  stock Int @default(0)
  minStock Int @default(5)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, stock])
}
model Customer {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  name String @db.VarChar(140)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  document String? @db.VarChar(40)
  address String? @db.VarChar(220)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales Sale[]
  @@index([businessId, name])
}
model Supplier {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  name String @db.VarChar(140)
  contactName String? @db.VarChar(120)
  email String? @db.VarChar(254)
  phone String? @db.VarChar(40)
  taxId String? @db.VarChar(40)
  address String? @db.VarChar(220)
  notes String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, name])
}
model Sale {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  customerId String? @db.Uuid
  number Int
  subtotal Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  paymentMethod String @default("cash") @db.VarChar(30)
  status String @default("paid") @db.VarChar(20)
  notes String? @db.Text
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items SaleItem[]
  @@unique([businessId, number])
  @@index([businessId, createdAt])
}
model SaleItem {
  id String @id @default(uuid()) @db.Uuid
  saleId String @db.Uuid
  productId String @db.Uuid
  productName String @db.VarChar(140)
  quantity Int
  unitPrice Decimal @db.Decimal(14,2)
  unitCost Decimal @db.Decimal(14,2)
  lineTotal Decimal @db.Decimal(14,2)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  @@index([saleId])
}
model Expense {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  description String @db.VarChar(180)
  category String @default("general") @db.VarChar(60)
  amount Decimal @db.Decimal(14,2)
  expenseDate DateTime @default(now())
  paymentMethod String? @db.VarChar(30)
  notes String? @db.Text
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, expenseDate])
}
model Promotion {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  name String @db.VarChar(120)
  description String? @db.Text
  discountType String @default("percentage") @db.VarChar(20)
  discountValue Decimal @db.Decimal(10,2)
  code String? @db.VarChar(40)
  startsAt DateTime?
  endsAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@index([businessId, active])
}
model StoreSettings {
  id String @id @default(uuid()) @db.Uuid
  businessId String @unique @db.Uuid
  slug String @unique @db.VarChar(100)
  headline String? @db.VarChar(160)
  description String? @db.Text
  published Boolean @default(false)
  whatsappNumber String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}
model Integration {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  provider String @db.VarChar(60)
  status String @default("disconnected") @db.VarChar(30)
  config Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, provider])
}
model TutorialProgress {
  id String @id @default(uuid()) @db.Uuid
  businessId String @db.Uuid
  userId String @db.Uuid
  completedSteps String[] @default([])
  skipped Boolean @default(false)
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([businessId, userId])
}
